<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jujin8.mj</groupId>
    <artifactId>mj</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>mj</name>
    <description>Freeway ecosystem package manager and build tool; strict dependency graphs
        (depth budgets, single version, declared-only visibility) that can pull from Maven
        Central and publish anywhere a URL can reach.</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <freeway.version>2.0.2-SNAPSHOT</freeway.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencies>
        <!-- mj's dependency closure is JDK + Freeway + the JUnit toolchain
             that mj test injects into user projects (DESIGN.md D11).
             freeway-commons supplies the shared TOML parser (D14),
             freeway-ioc the container mj assembles itself with. -->
        <dependency>
            <groupId>com.jujin8.freeway</groupId>
            <artifactId>freeway-commons</artifactId>
            <version>${freeway.version}</version>
        </dependency>
        <dependency>
            <groupId>com.jujin8.freeway</groupId>
            <artifactId>freeway-ioc</artifactId>
            <version>${freeway.version}</version>
        </dependency>
        <!-- mj test 的 JUnit 工具链:launcher 执行、engine 跑 Jupiter 测试、
             api 供测试类发现(org.junit.* 注解检测)。坐标由 mj 管理并经
             store 钉定,与其它依赖同等待遇(DESIGN.md mj test)。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <workingDirectory>${project.build.directory}/test-work</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
